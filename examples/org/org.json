{
  "id": "o-a1b2c3d4e5",
  "management_account": "111111111111",
  "roots": [{ "id": "r-ab12", "name": "Root", "policies": ["p-FullAWSAccess", "p-RCPFullAWSAccess", "p-deny-leave-org"] }],
  "ous": [
    { "id": "ou-ab12-prod", "name": "Prod", "parent": "r-ab12", "policies": ["p-FullAWSAccess", "p-RCPFullAWSAccess", "p-region-guard", "p-data-perimeter"] },
    { "id": "ou-ab12-sandbox", "name": "Sandbox", "parent": "r-ab12", "policies": ["p-FullAWSAccess", "p-RCPFullAWSAccess"] }
  ],
  "accounts": [
    { "id": "111111111111", "name": "management", "parent": "r-ab12", "policies": ["p-FullAWSAccess", "p-RCPFullAWSAccess"] },
    { "id": "123456789012", "name": "app-prod", "parent": "ou-ab12-prod", "policies": ["p-FullAWSAccess", "p-RCPFullAWSAccess"] },
    { "id": "222222222222", "name": "sandbox", "parent": "ou-ab12-sandbox", "policies": ["p-FullAWSAccess", "p-RCPFullAWSAccess"] }
  ],
  "policies": {
    "p-FullAWSAccess": {
      "name": "FullAWSAccess", "type": "SERVICE_CONTROL_POLICY",
      "document": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Action": "*", "Resource": "*" }] }
    },
    "p-RCPFullAWSAccess": {
      "name": "RCPFullAWSAccess", "type": "RESOURCE_CONTROL_POLICY",
      "document": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Principal": "*", "Action": "*", "Resource": "*" }] }
    },
    "p-deny-leave-org": {
      "name": "DenyLeaveOrganization", "type": "SERVICE_CONTROL_POLICY",
      "document": { "Version": "2012-10-17", "Statement": [{ "Effect": "Deny", "Action": "organizations:LeaveOrganization", "Resource": "*" }] }
    },
    "p-region-guard": {
      "name": "RegionGuard", "type": "SERVICE_CONTROL_POLICY",
      "document": { "Version": "2012-10-17", "Statement": [{
        "Effect": "Deny", "NotAction": ["iam:*", "sts:*", "organizations:*", "support:*"], "Resource": "*",
        "Condition": { "StringNotEquals": { "aws:RequestedRegion": ["eu-west-1", "us-east-1"] } }
      }] }
    },
    "p-data-perimeter": {
      "name": "DataPerimeter", "type": "RESOURCE_CONTROL_POLICY",
      "document": { "Version": "2012-10-17", "Statement": [
        {
          "Sid": "OnlyOrgPrincipals", "Effect": "Deny", "Principal": "*",
          "Action": ["s3:*", "sts:AssumeRole", "kms:*", "secretsmanager:*"], "Resource": "*",
          "Condition": {
            "StringNotEqualsIfExists": { "aws:PrincipalOrgID": "o-a1b2c3d4e5" },
            "BoolIfExists": { "aws:PrincipalIsAWSService": "false" }
          }
        },
        {
          "Sid": "TlsOnly", "Effect": "Deny", "Principal": "*", "Action": "s3:*", "Resource": "*",
          "Condition": { "BoolIfExists": { "aws:SecureTransport": "false" } }
        }
      ] }
    }
  }
}
